# 루빗 사이트 — VPS 환경변수 템플릿
#
# 사용법
#   1. 이 파일을 .env 로 복사합니다 (확장자만 .env, 내용은 비어 있는 상태).
#        Copy-Item .env.example .env
#   2. 아래 빈 칸에 값을 채웁니다. 값은 로컬 프로젝트의 .dev.vars 에서 복사해 옵니다.
#   3. .env 는 절대 git·채팅·메일에 올리지 마세요. (.gitignore 에 이미 들어 있습니다)
#
# 회색 설명은 지워도 되고, 값 뒤에 공백을 넣지 마세요.

# --- 기본 ---------------------------------------------------------------
# 사이트 주소. 로그인 콜백·쿠키·안내 문구가 이 값을 기준으로 만들어집니다.
ORIGIN=https://lubit.kr

# 서버가 열 포트. 바꾸면 Caddyfile 의 reverse_proxy 포트도 같이 바꿔야 합니다.
PORT=8080

# --- 관리자 수신함 ------------------------------------------------------
# /support/inbox 접속 비밀번호. .dev.vars 와 같은 값이어야 예전 링크가 그대로 열립니다.
INBOX_TOKEN=

# 문의·채팅 알림을 받을 디스코드 웹훅 URL.
DISCORD_WEBHOOK_URL=

# --- 디스코드 로그인 (선택) ---------------------------------------------
# 리다이렉트 URI 가 도메인 기준이라 그대로 lubit.kr 이므로 개발자 콘솔은 손댈 필요 없습니다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- 구글 로그인 (선택) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 서버 구동기: 도메인 자동 등록 (선택) -------------------------------
# 데스크톱 앱이 서버 도메인을 자동으로 만들 때만 씁니다.
# Cloudflare → lubit.kr 존 → API 토큰 (Zone.DNS 편집 권한)
# 이 값이 없으면 구동기의 "도메인 자동 등록" 버튼만 비활성화됩니다.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- 서버 구동기: 중계 서버 (relay/ 를 이 VPS 에서 돌릴 때만) -----------
RELAY_HOST=
RELAY_IP=
RELAY_CONTROL_PORT=7777

# --- 이전에 없는 것 하나 ------------------------------------------------
# 클라우드 백업(BACKUPS/R2)은 Cloudflare 전용 저장소라 VPS 에서는 빠집니다.
# 해당 기능만 "클라우드 백업 저장소가 아직 연결되지 않았습니다" 로 응답하고,
# 나머지 사이트·API·로그인은 모두 정상 동작합니다.

# 릴리스 후 패치노트를 디스코드로 올릴 때 씁니다 (scripts/discord-notify.mjs).
DISCORD_WEBHOOK=
