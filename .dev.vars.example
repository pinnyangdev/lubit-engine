# 이 파일을 .dev.vars 로 복사해 값을 채워 주세요. (.dev.vars 는 git 에 올라가지 않습니다)
#
# 디스코드 채널 → 설정 → 통합 → 웹훅 → 새 웹훅 → URL 복사
DISCORD_WEBHOOK_URL=

# 관리자 수신함(/support/inbox) 접속 비밀번호. 임의의 긴 문자열로 바꿔 주세요.
INBOX_TOKEN=

# 디스코드 로그인 (선택).
#   1. https://discord.com/developers/applications → New Application
#   2. OAuth2 탭 → Redirects 에 아래 주소를 등록
#        운영  : https://lubit.kr/api/engine/auth/discord/callback
#        로컬  : http://localhost:5173/api/engine/auth/discord/callback
#   3. Client ID 와 Client Secret 을 복사해 넣기 (설정한 뒤에만 버튼이 열립니다)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 위 두 값을 채운 뒤, 운영 워커에도 그대로 옮깁니다 (값은 화면에 찍히지 않습니다).
#   node scripts/put-secrets.mjs DISCORD_CLIENT_ID DISCORD_CLIENT_SECRET
#
# 구글 로그인 (선택). 채우면 웹·앱에 “구글로 로그인” 버튼이 열립니다.
#   1. https://console.cloud.google.com/apis/credentials → OAuth 동의 화면 먼저 설정
#      (앱 이름·이용자 지원 이메일 입력, 테스트 사용자에 내 계정 추가)
#   2. 자격 증명 만들기 → OAuth 클라이언트 ID → 웹 애플리케이션
#   3. 승인된 리디렉션 URI 에 아래 주소 등록
#        운영  : https://lubit.kr/api/engine/auth/google/callback
#        로컬  : http://localhost:5173/api/engine/auth/google/callback
#        앱    : http://127.0.0.1:51555/callback
#   4. 클라이언트 ID 와 시크릿 복사해 넣기
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# 구글 값을 채운 뒤 운영 워커에도 옮깁니다.
#   node scripts/put-secrets.mjs GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET
#
# 중계 서버 — VPS 를 올린 뒤 채웁니다 (자세한 절차는 relay/README.md).
RELAY_HOST=
RELAY_IP=
RELAY_CONTROL_PORT=7777

# --- 서버 구동기: 도메인 자동 등록 -------------------------------------------
# Cloudflare 대시보드 → lubit.kr 존 → My Profile → API 토큰(Zone.DNS 편집 권한)
# 토큰은 절대 채팅에 붙여넣지 말고 아래 파일에만 넣어 주세요.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- 서버 구동기: 중계 서버(포트포워딩 없이 접속) ----------------------------
# relay/ 폴더를 VPS 에서 돌린 뒤, 그 서버의 도메인/IP 를 적습니다.
RELAY_HOST=
RELAY_IP=
RELAY_CONTROL_PORT=7777
