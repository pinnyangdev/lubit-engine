# 루빗 사이트 — Caddy 설정 (C:\caddy\Caddyfile 로 복사해서 씁니다)
#
#   caddy run --config C:\caddy\Caddyfile
#
# 인증서는 Let's Encrypt 에서 알아서 발급·갱신합니다.
# 80·443 포트가 열려 있어야 하고, DNS 가 이 VPS 를 가리키고 있어야 발급됩니다.
# (DNS 넘기기 전에 먼저 띄우면 인증서 발급이 실패합니다 — 순서 주의)

lubit.kr, www.lubit.kr {
	# 압축. 설치판 조각(/download/*.bin)은 이미 압축된 파일이라 굳이 다시 압축하지 않습니다.
	encode zstd gzip

	# 뒤에서 돌고 있는 Node 서버 (server/index.mjs)
	reverse_proxy 127.0.0.1:8080 {
		# 설치판 20MB 조각과 최대 2GB 백업 업로드를 막지 않도록 시간을 넉넉히 줍니다.
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	# 서버 로그 (문제 생겼을 때 C:\caddy\access.log 확인)
	log {
		output file C:\caddy\access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
